@{
    ViewData["Title"] = "Kasa & Banka Yönetimi";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
    <li class="breadcrumb-item"><a href="/CashAccounts">Finans Yönetimi</a></li>
    <li class="breadcrumb-item active">Kasa & Banka</li>
}

@Html.AntiForgeryToken()

<!-- ─── Page Header ─────────────────────────────────────────────────────────── -->
<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">
            <i class="bi bi-wallet2 me-2 text-primary"></i>Kasa & Banka Yönetimi
        </h1>
        <p class="page-subtitle">
            Nakit kasa hesaplarınızı, banka VADESİZ/MEVDUAT hesaplarınızı ve nakit akış hareketlerinizi yönetin.
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <button class="btn-export-excel" onclick="exportCurrentTabToCSV()" title="Tabloyu Excel/CSV olarak indir">
            <i class="bi bi-file-earmark-excel"></i> Excel İndir
        </button>
        <button class="btn-export-print" onclick="printCurrentTab()" title="Listeyi Yazdır">
            <i class="bi bi-printer"></i> Yazdır
        </button>
        <button class="btn btn-sm btn-outline-secondary" onclick="refreshAll()" title="Yenile">
            <i class="bi bi-arrow-clockwise me-1"></i>Yenile
        </button>
        <button class="btn-efbis-primary" onclick="showCreateAccountModal()">
            <i class="bi bi-plus-lg me-1"></i>Yeni Hesap
        </button>
        <button class="btn btn-success fw-600 px-3 py-2" onclick="showCreateTransactionModal()" style="font-size:13px;border-radius:8px;">
            <i class="bi bi-arrow-left-right me-1"></i>Yeni İşlem
        </button>
    </div>
</div>

<!-- ─── Dashboard Stat Cards ─────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left: 4px solid #10b981;">
            <div class="stat-icon green"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="stat-value text-success" id="totalCashBalance">0,00 ₺</div>
                <div class="stat-label">💵 Nakit Kasa Bakiyesi</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left: 4px solid #6366f1;">
            <div class="stat-icon purple"><i class="bi bi-bank"></i></div>
            <div>
                <div class="stat-value text-primary" id="totalBankBalance">0,00 ₺</div>
                <div class="stat-label">🏦 Banka Mevduat Bakiyesi</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left: 4px solid #0284c7;">
            <div class="stat-icon" style="background:#e0f2fe;color:#0284c7;"><i class="bi bi-credit-card-2-front"></i></div>
            <div>
                <div class="stat-value" style="color:#0284c7;" id="totalPosBalance">0,00 ₺</div>
                <div class="stat-label">💳 POS Terminal Kasaları</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left: 4px solid #06b6d4;">
            <div class="stat-icon" style="background:#ecfeff;color:#0891b2;"><i class="bi bi-arrow-down-circle"></i></div>
            <div>
                <div class="stat-value text-info" id="todayCollections">0,00 ₺</div>
                <div class="stat-label">📥 Günlük Tahsilat (Giriş)</div>
            </div>
        </div>
    </div>
</div>

<!-- ─── Main Content Card ──────────────────────────────────────────────────────── -->
<div class="efbis-card">
    <div class="efbis-card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
        <ul class="nav nav-pills custom-pills" id="cashTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="accounts-tab" data-bs-toggle="tab" data-bs-target="#accounts" type="button" role="tab">
                    <i class="bi bi-journal-bookmark me-1"></i>Tüm Kasa & Banka Hesapları
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="transactions-tab" data-bs-toggle="tab" data-bs-target="#transactions" type="button" role="tab">
                    <i class="bi bi-arrow-left-right me-1"></i>Kasa & Banka Hareketleri
                </button>
            </li>
        </ul>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary fw-normal" id="totalBadge">0 kayıt</span>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="p-3 border-bottom bg-light">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" id="searchInput" class="search-input" placeholder="Hesap adı, kodu veya banka adı ara..." oninput="debounceSearch()" />
                </div>
            </div>
            <div class="col-6 col-md-3" id="typeFilterCol">
                <select class="filter-select w-100" id="accountTypeFilter" onchange="loadAccounts(1)">
                    <option value="">Tüm Hesap Tipleri</option>
                    <option value="1">💵 Fiziksel Nakit Kasası</option>
                    <option value="2">🏦 Ticari Banka Mevduat Hesabı</option>
                    <option value="3">💳 POS Terminal Kasası (Gün Sonu)</option>
                    <option value="4">📱 Sanal POS / Kredi Kartı Hesabı</option>
                </select>
            </div>
            <div class="col-6 col-md-3 d-none" id="txTypeFilterCol">
                <select class="filter-select w-100" id="txTypeFilter" onchange="loadTransactions(1)">
                    <option value="">Tüm İşlem Tipleri</option>
                    <option value="1">Tahsilat (Giriş)</option>
                    <option value="2">Tediye (Çıkış)</option>
                    <option value="3">Virman (Transfer)</option>
                </select>
            </div>
            <div class="col-6 col-md-2 ms-auto text-end">
                <select class="filter-select" id="pageSizeSelect" onchange="refreshCurrentTab()">
                    <option value="10">10 / Sayfa</option>
                    <option value="25">25 / Sayfa</option>
                    <option value="50">50 / Sayfa</option>
                </select>
            </div>
        </div>
    </div>

    <div class="tab-content" id="cashTabsContent">
        <!-- Accounts Tab -->
        <div class="tab-pane fade show active" id="accounts" role="tabpanel">
            <div class="table-responsive" id="accountsTableWrapper">
                <table class="efbis-table" id="accountsTable">
                    <thead>
                        <tr>
                            <th>Hesap Kodu</th>
                            <th>Hesap Adı</th>
                            <th>Hesap Tipi</th>
                            <th>Banka Adı</th>
                            <th>IBAN / Detay</th>
                            <th>Bakiye</th>
                            <th>Durum</th>
                            <th style="text-align:center;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="accountsBody">
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="spinner-efbis mx-auto d-block mb-2"></div>
                                <span class="text-muted">Yükleniyor...</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Transactions Tab -->
        <div class="tab-pane fade" id="transactions" role="tabpanel">
            <div class="table-responsive" id="transactionsTableWrapper">
                <table class="efbis-table" id="transactionsTable">
                    <thead>
                        <tr>
                            <th>İşlem Kodu</th>
                            <th>İşlem Tipi</th>
                            <th>Kasa / Banka Hesabı</th>
                            <th>İlişkili Cari (Müşteri/Tedarikçi)</th>
                            <th>Tutar</th>
                            <th>Tarih</th>
                            <th>Açıklama</th>
                        </tr>
                    </thead>
                    <tbody id="transactionsBody">
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="spinner-efbis mx-auto d-block mb-2"></div>
                                <span class="text-muted">Yükleniyor...</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between px-4 py-3 border-top" style="background:#fafbfc;">
        <div class="text-muted" style="font-size:13px;" id="paginationInfo">—</div>
        <div class="efbis-pagination" id="paginationButtons"></div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!-- CREATE ACCOUNT MODAL -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade modal-efbis" id="createAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2 text-primary"></i>Yeni Kasa / Banka Hesabı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createAccountForm" onsubmit="event.preventDefault(); saveAccount();">
                    <div class="mb-3">
                        <label class="efbis-label">Hesap Tipi <span class="required">*</span></label>
                        <select class="efbis-select" name="AccountType" id="accAccountType" onchange="toggleBankFields()" required>
                            <option value="1">💵 Fiziksel Nakit Kasası</option>
                            <option value="2">🏦 Ticari Banka Mevduat Hesabı</option>
                            <option value="3">💳 POS Terminal Kasası (Gün Sonu)</option>
                            <option value="4">📱 Sanal POS / Kredi Kartı Hesabı</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="efbis-label">Hesap Kodu <span class="required">*</span></label>
                            <input type="text" class="efbis-input" name="AccountCode" id="accAccountCode" placeholder="KSA-002" required />
                        </div>
                        <div class="col-6">
                            <label class="efbis-label">Hesap Adı <span class="required">*</span></label>
                            <input type="text" class="efbis-input" name="AccountName" id="accAccountName" placeholder="Merkez Kasa / Garanti Ticari" required />
                        </div>
                    </div>
                    <div id="bankFields" class="d-none">
                        <div class="mb-3">
                            <label class="efbis-label">Banka Adı</label>
                            <input type="text" class="efbis-input" name="BankName" id="accBankName" placeholder="Garanti BBVA, Akbank vb." />
                        </div>
                        <div class="mb-3">
                            <label class="efbis-label">IBAN Numarası</label>
                            <input type="text" class="efbis-input" name="Iban" id="accIban" placeholder="TR00 0000 0000 0000 0000 0000 00" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="efbis-label">Başlangıç Bakiyesi (₺)</label>
                        <input type="number" step="0.01" class="efbis-input" name="InitialBalance" id="accInitialBalance" value="0.00" />
                    </div>
                    <div class="mb-3">
                        <label class="efbis-label">Açıklama</label>
                        <textarea class="efbis-input" name="Description" id="accDescription" rows="2" placeholder="Hesap hakkında detay..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn-efbis-primary" onclick="saveAccount()">
                    <i class="bi bi-check-lg me-1"></i>Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!-- CREATE TRANSACTION MODAL -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade modal-efbis" id="createTransactionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#059669,#10b981);">
                <h5 class="modal-title text-white">
                    <i class="bi bi-arrow-left-right me-2"></i>Yeni Kasa / Banka İşlemi
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createTransactionForm" onsubmit="event.preventDefault(); saveTransaction();">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="efbis-label">İşlem Tipi <span class="required">*</span></label>
                            <select class="efbis-select" name="TransactionType" id="txTransactionType" onchange="onTransactionTypeChange()" required>
                                <option value="1">Tahsilat (Müşteriden Alınan Nakit/Havale)</option>
                                <option value="2">Tediye (Tedarikçiye Ödenen Nakit/Havale)</option>
                                <option value="3">Virman (Hesaplar Arası Transfer)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="efbis-label" id="lblCashAccount">Kasa / Banka Hesabı <span class="required">*</span></label>
                            <select class="efbis-select" name="CashAccountId" id="txCashAccountId" required></select>
                        </div>
                    </div>

                    <!-- Virman İçin Hedef Hesap -->
                    <div class="mb-3 d-none" id="targetAccountGroup">
                        <label class="efbis-label">Hedef Hesap (Para Aktarılacak) <span class="required">*</span></label>
                        <select class="efbis-select" name="TargetAccountId" id="txTargetAccountId"></select>
                    </div>

                    <!-- Cari Seçimi (Tahsilat & Tediye İçin) -->
                    <div class="mb-3" id="customerGroup">
                        <label class="efbis-label">İlişkili Cari (Müşteri / Tedarikçi)</label>
                        <select class="efbis-select" name="CustomerId" id="txCustomerId">
                            <option value="">-- Cari Seçilmeyebilir --</option>
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="efbis-label">Tutar (₺) <span class="required">*</span></label>
                            <div class="input-group-price">
                                <span class="currency-prefix">₺</span>
                                <input type="number" step="0.01" min="0.01" class="efbis-input" name="Amount" id="txAmount" placeholder="0.00" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="efbis-label">İşlem Tarihi</label>
                            <input type="datetime-local" class="efbis-input" name="TransactionDate" id="txTransactionDate" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="efbis-label">Açıklama / Not</label>
                        <textarea class="efbis-input" name="Description" id="txDescription" rows="2" placeholder="Fatura no, tahsilat açıklaması vb."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success fw-600 px-4" onclick="saveTransaction()">
                    <i class="bi bi-check-circle me-1"></i>İşlemi Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cashAccounts.js" asp-append-version="true"></script>
}
