@{
    ViewData["Title"] = "Gelir & Gider Yönetimi";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
    <li class="breadcrumb-item"><a href="/IncomeExpenses">Finans Yönetimi</a></li>
    <li class="breadcrumb-item active">Gelir & Gider</li>
}

@Html.AntiForgeryToken()

<!-- ─── Page Header ─────────────────────────────────────────────────────────── -->
<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">
            <i class="bi bi-graph-up-arrow me-2 text-success"></i>Gelir & Gider Yönetimi
        </h1>
        <p class="page-subtitle">
            Şirketinizin tüm kira, fatura, maaş, prim ve diğer operasyonel gelir/gider hareketlerini takip edin.
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <button class="btn-export-excel" onclick="exportTableToCSV('recordsTable', 'gelir_gider_listesi.csv')" title="Tabloyu Excel/CSV olarak indir">
            <i class="bi bi-file-earmark-excel"></i> Excel İndir
        </button>
        <button class="btn-export-print" onclick="printTable('recordsTable', 'Gelir & Gider Hareketleri Listesi')" title="Listeyi Yazdır">
            <i class="bi bi-printer"></i> Yazdır
        </button>
        <button class="btn btn-sm btn-outline-secondary" onclick="refreshAll()" title="Yenile">
            <i class="bi bi-arrow-clockwise me-1"></i>Yenile
        </button>
        <button class="btn-efbis-primary" onclick="showCreateModal()">
            <i class="bi bi-plus-lg me-1"></i>Yeni Gelir / Gider Ekle
        </button>
    </div>
</div>

<!-- ─── Dashboard Stat Cards ─────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left: 4px solid #10b981;">
            <div class="stat-icon green"><i class="bi bi-arrow-down-left-circle"></i></div>
            <div>
                <div class="stat-value text-success" id="totalIncome">0,00 ₺</div>
                <div class="stat-label">Toplam Gelir</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left: 4px solid #ef4444;">
            <div class="stat-icon red"><i class="bi bi-arrow-up-right-circle"></i></div>
            <div>
                <div class="stat-value text-danger" id="totalExpense">0,00 ₺</div>
                <div class="stat-label">Toplam Gider</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card" id="netProfitCard" style="border-left: 4px solid #6366f1;">
            <div class="stat-icon purple"><i class="bi bi-pie-chart"></i></div>
            <div>
                <div class="stat-value text-primary" id="netProfit">0,00 ₺</div>
                <div class="stat-label">Net Kâr / Zarar</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left: 4px solid #06b6d4;">
            <div class="stat-icon" style="background:#ecfeff;color:#0891b2;"><i class="bi bi-journal-text"></i></div>
            <div>
                <div class="stat-value text-info" id="transactionCount">0</div>
                <div class="stat-label">Toplam İşlem Sayısı</div>
            </div>
        </div>
    </div>
</div>

<!-- ─── Main Content Card ──────────────────────────────────────────────────────── -->
<div class="efbis-card">
    <div class="efbis-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="efbis-card-title">
            <i class="bi bi-receipt-cutoff text-primary"></i>
            Gelir & Gider İşlem Listesi
            <span class="badge bg-secondary fw-normal ms-1" id="totalBadge">0 kayıt</span>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="p-3 border-bottom bg-light">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-3">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" id="searchInput" class="search-input" placeholder="Kod, kategori veya açıklama..." oninput="debounceSearch()" />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <select class="filter-select w-100" id="typeFilter" onchange="loadRecords(1)">
                    <option value="">Tüm İşlem Tipleri</option>
                    <option value="1">🟢 Gelir</option>
                    <option value="2">🔴 Gider</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select class="filter-select w-100" id="categoryFilter" onchange="loadRecords(1)">
                    <option value="">Tüm Kategoriler</option>
                    <option value="Kira">Kira Gideri</option>
                    <option value="Elektrik">Elektrik</option>
                    <option value="Su">Su Faturası</option>
                    <option value="Doğalgaz">Doğalgaz</option>
                    <option value="İnternet">İnternet & İletişim</option>
                    <option value="Maaş">Maaş & Ödemeler</option>
                    <option value="Prim">Personel Primi</option>
                    <option value="Danışmanlık">Danışmanlık & Hizmet</option>
                    <option value="Satış Geliri">Satış Geliri</option>
                    <option value="Faiz Geliri">Faiz Geliri</option>
                    <option value="Diğer">Diğer Operasyonel</option>
                </select>
            </div>
            <div class="col-12 col-md-2 ms-auto text-end">
                <select class="filter-select" id="pageSizeSelect" onchange="loadRecords(1)">
                    <option value="10">10 / Sayfa</option>
                    <option value="25">25 / Sayfa</option>
                    <option value="50">50 / Sayfa</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive" id="recordsTableWrapper">
        <table class="efbis-table" id="recordsTable">
            <thead>
                <tr>
                    <th>İşlem Kodu</th>
                    <th>İşlem Tipi</th>
                    <th>Kategori</th>
                    <th>Tutar</th>
                    <th>İlişkili Kasa / Banka</th>
                    <th>İlişkili Cari</th>
                    <th>İşlem Tarihi</th>
                    <th>Açıklama</th>
                    <th style="text-align:center;">İşlemler</th>
                </tr>
            </thead>
            <tbody id="recordsBody">
                <tr>
                    <td colspan="9" class="text-center py-5">
                        <div class="spinner-efbis mx-auto d-block mb-2"></div>
                        <span class="text-muted">Yükleniyor...</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex align-items-center justify-content-between px-4 py-3 border-top" style="background:#fafbfc;">
        <div class="text-muted" style="font-size:13px;" id="paginationInfo">—</div>
        <div class="efbis-pagination" id="paginationButtons"></div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!-- CREATE MODAL -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade modal-efbis" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#059669,#10b981);">
                <h5 class="modal-title text-white"><i class="bi bi-plus-circle me-2"></i>Yeni Gelir / Gider Kaydı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createForm" onsubmit="event.preventDefault(); saveRecord();">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="efbis-label">İşlem Tipi <span class="required">*</span></label>
                            <select class="efbis-select" name="Type" id="recType" required>
                                <option value="1">🟢 Gelir (Kasa/Bankaya Giriş)</option>
                                <option value="2">🔴 Gider (Kasa/Bankadan Çıkış)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="efbis-label">Kategori <span class="required">*</span></label>
                            <input type="text" class="efbis-input" name="CategoryName" id="recCategoryName" list="categoryList" placeholder="Kira, Elektrik, Maaş vb." required />
                            <datalist id="categoryList">
                                <option value="Kira Gideri"></option>
                                <option value="Maaş & Ödemeler"></option>
                                <option value="Elektrik"></option>
                                <option value="Su Faturası"></option>
                                <option value="Doğalgaz"></option>
                                <option value="İnternet & İletişim"></option>
                                <option value="Satış Geliri"></option>
                                <option value="Danışmanlık Geliri"></option>
                                <option value="Faiz Geliri"></option>
                                <option value="Personel Primi"></option>
                                <option value="Diğer"></option>
                            </datalist>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="efbis-label">Kasa / Banka Hesabı (Opsiyonel)</label>
                            <select class="efbis-select" name="CashAccountId" id="cashAccountSelect">
                                <option value="">-- Kasa/Banka Seçilmeyebilir --</option>
                            </select>
                            <small class="text-muted" style="font-size:11px;">Seçilirse bakiyeden otomatik düşülür/eklenir.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="efbis-label">İlişkili Cari (Müşteri / Tedarikçi)</label>
                            <select class="efbis-select" name="CustomerId" id="customerSelect">
                                <option value="">-- Cari Seçilmeyebilir --</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="efbis-label">Tutar (₺) <span class="required">*</span></label>
                            <div class="input-group-price">
                                <span class="currency-prefix">₺</span>
                                <input type="number" step="0.01" min="0.01" class="efbis-input" name="Amount" id="recAmount" placeholder="0.00" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="efbis-label">İşlem Tarihi</label>
                            <input type="datetime-local" class="efbis-input" name="TransactionDate" id="recTransactionDate" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="efbis-label">Açıklama / Not</label>
                        <textarea class="efbis-input" name="Description" id="recDescription" rows="2" placeholder="Fatura numarası veya işlem açıklaması..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success fw-600 px-4" onclick="saveRecord()">
                    <i class="bi bi-check-circle me-1"></i>Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/incomeExpenses.js" asp-append-version="true"></script>
}
