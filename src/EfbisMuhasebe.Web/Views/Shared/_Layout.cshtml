    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function openChangePasswordModal() {
            document.getElementById('changePasswordForm')?.reset();
            new bootstrap.Modal(document.getElementById('changePasswordModal')).show();
        }

        function submitChangePassword() {
            const current = $('#currentPassword').val();
            const newPass = $('#newPassword').val();
            const confirmPass = $('#confirmPassword').val();

            if (!current || !newPass || !confirmPass) {
                showToast('Lütfen tüm alanları doldurunuz.', 'warning');
                return;
            }

            if (newPass !== confirmPass) {
                showToast('Yeni şifreler eşleşmiyor.', 'warning');
                return;
            }

            efbisAjax.post('/Account/ChangePassword', {
                currentPassword: current,
                newPassword: newPass,
                confirmPassword: confirmPass
            }).then(function(res) {
                if (res && res.success) {
                    showToast(res.message || 'Şifreniz başarıyla değiştirildi.', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('changePasswordModal')).hide();
                } else {
                    showToast((res && res.message) || 'Hata oluştu.', 'error');
                }
            });
        }

        function logoutUser() {
            if (confirm('Oturumunuzu kapatmak istediğinize emin misiniz?')) {
                efbisAjax.post('/Account/Logout', {}).then(function(res) {
                    if (res && res.success) {
                        window.location.href = res.redirectUrl || '/Account/Login';
                    }
                });
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
